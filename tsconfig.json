{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "rootDir": ".",
    "outDir": "dist",

    "declaration": true,
    "sourceMap": true,

    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts"
  ]
}